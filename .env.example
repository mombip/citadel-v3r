# PostgreSQL connection. Leave empty to use the embedded PGlite database (stored in PGLITE_DIR).
DATABASE_URL=postgresql://user:password@localhost:5432/citadel_db
# Directory for the embedded database when DATABASE_URL is empty (omit for in-memory).
PGLITE_DIR=.pglite
# Random secret for signing session cookies (required in production).
SESSION_SECRET=change-me
PORT=8700
# Set to 1 to load demo data into an empty database.
SEED_DEMO=0

# --- Database migration (scripts/supabase/migrate-data.ts, `npm run db:migrate` / `npm run db:verify`) ---
# Source: the current production database (Netlify Database: app.netlify.com → citadel-ng → Database → connection string).
SOURCE_DB_URL=
# Target: Supabase → project → Connect → "Transaction pooler" string (port 6543, user postgres.<project-ref>).
# URL-encode special characters in the password. The same string goes into Netlify as DATABASE_URL at cutover.
TARGET_DB_URL=
